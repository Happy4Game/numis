# =====================================================================
#  Variables d'environnement — COPIER vers .env et adapter.
#  .env NE DOIT JAMAIS être commité (voir .gitignore).
#  Les secrets "réels" de démo sont chiffrés avec SOPS (voir secrets.enc.env).
# =====================================================================

# --- Base de données (fictive) ---
DB_USER=rsa_app
DB_PASSWORD=change_me_db
DB_NAME=rsa_payments

# --- Authentification ---
JWT_SECRET=change_me_jwt_secret_32chars_min

# --- Jeton partagé ml-detector -> remediation-engine (authentifie les demandes d'action) ---
REMEDIATION_TOKEN=change_me_remediation_token

# --- Observabilité ---
GRAFANA_PASSWORD=change_me_grafana

# --- IA locale ---
OLLAMA_MODEL=qwen2.5:3b

# --- Divers ---
LOG_LEVEL=INFO

# --- Consigne additionnelle 1 : MFA (reconnaissance faciale) + ESP8266 ---
# URL du module ESP8266 sur le PA RESILIENCE-G<n> (ex: http://192.168.137.50). Vide = pas de LED.
ESP_URL=
# Seuil de reconnaissance faciale (distance LBPH ; plus bas = plus strict)
FACE_THRESHOLD=95
